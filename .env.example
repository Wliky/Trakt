# 服务端口
PORT=8787
HOST=0.0.0.0

# 数据目录（默认 ./data，存 db.json：账号令牌 + 会话）
DATA_DIR=./data

# 会话 cookie 是否强制 Secure：auto / true / false
# 本地 http 用 false 或 auto；套 HTTPS 反代（Nginx/Caddy/Cloudflare）后用 true
COOKIE_SECURE=auto

# ── 以下一般不用改，留空即用内置默认值 ──
# 认证域
TRAKT_AUTH_BASE=https://auth.trakt.tv
# 数据域（网页版数据域，Bearer + 官方 client_id）
TRAKT_API_BASE=https://apiz.trakt.tv
# 网页版公开 client_id（无需自建应用）
TRAKT_CLIENT_ID=
TRAKT_USER_AGENT=TraktManager/1.0.0 (+self-hosted)

# ── 海报 / 影视信息（可选）──
# 不填则使用 Trakt 自带海报与元数据；填了切换为 TMDB（中文标题/简介）
TMDB_API_KEY=
# 或使用 v4 Read Access Token（二选一）
TMDB_TOKEN=
TMDB_LANG=zh-CN
