{
  "name": "Trakt",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "description": "自托管的 Trakt 观影数据管理中心：邮箱验证码登录（无需创建 OAuth 应用），管理观看历史、评分、收藏与片单，支持 Node / Docker / Cloudflare Workers + D1 部署",
  "homepage": "https://trakt.wliky.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wliky/Trakt.git"
  },
  "keywords": [
    "trakt",
    "self-hosted",
    "watch-history",
    "cloudflare-workers",
    "d1",
    "docker"
  ],
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "deploy:cf": "node scripts/deploy-cf.mjs",
    "db:init": "node scripts/ensure-d1.mjs"
  }
}
